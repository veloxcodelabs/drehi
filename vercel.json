{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/auth-code",
      "destination": "/api/auth-code.ts"
    },
    {
      "source": "/api/config",
      "destination": "/api/config.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
