# Image generation token from https://vmodel.ai (server only — never put this in the browser or in git).
# Google AI Pro does not cover this. A Gemini API key is not used for try-on.
VMODEL_API_TOKEN=""

# Password for the /admin page. Also used to reset the practice code "test".
ADMIN_PASSWORD=""

# Firebase service account JSON (one line, or base64). Required on Vercel so the 3-try counter
# survives across serverless instances. Firebase console → Project settings → Service accounts →
# Generate new private key. Project: gen-lang-client-0467803642.
# Do not commit the JSON file.
FIREBASE_SERVICE_ACCOUNT=""

# Optional. Defaults to firestoreDatabaseId in firebase-applet-config.json.
# FIRESTORE_DATABASE_ID=""

# Public site URL. Optional. Example: https://clothes.martitony.com
APP_URL=""
