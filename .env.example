# VMODEL_API_TOKEN: Server-side API token for model generation and task polling.
VMODEL_API_TOKEN=""

# GEMINI_API_KEY: Optional Gemini API key if prompt expansion or fallback is enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password protecting the /admin dashboard route
ADMIN_PASSWORD=""
